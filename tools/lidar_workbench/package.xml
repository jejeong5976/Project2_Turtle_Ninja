<?xml version="1.0"?>
<package format="3">
  <name>lidar_workbench</name><version>0.1.0</version>
  <description>Desktop dual LiDAR and bounded wheel-motion workbench.</description>
  <maintainer email="team@example.com">Project2 team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend><depend>nav_msgs</depend><depend>std_msgs</depend>
  <depend>geometry_msgs</depend><depend>tf2_msgs</depend><depend>tf2_ros</depend>
  <depend>slam_toolbox</depend><depend>yaml-cpp</depend>
  <depend>rosbag2_cpp</depend>
  <exec_depend>bringup</exec_depend><exec_depend>rosbag2</exec_depend>
  <exec_depend>rosbag2_storage_sqlite3</exec_depend><exec_depend>rviz2</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
