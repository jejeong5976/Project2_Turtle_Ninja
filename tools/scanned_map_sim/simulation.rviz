Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 0.5
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Alpha: 0.7
    Color Scheme: map
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
    Update Topic:
      Value: /map_updates
    Value: true
  - Class: rviz_default_plugins/LaserScan
    Name: ScanFront
    Enabled: true
    Size (m): 0.02
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 60; 60
    Topic:
      Value: /lidar_front/scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
    Value: true
  - Class: rviz_default_plugins/LaserScan
    Name: ScanRear
    Enabled: true
    Size (m): 0.02
    Style: Points
    Color Transformer: FlatColor
    Color: 60; 120; 255
    Topic:
      Value: /lidar_rear/scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
    Value: true
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
    Value: true
    Alpha: 0.4
  - Class: rviz_default_plugins/Path
    Name: Nav2 plan
    Enabled: true
    Color: 210; 155; 65
    Line Style: Lines
    Line Width: 0.02
    Topic:
      Value: /plan
      Durability Policy: Volatile
    Value: true
  - Class: rviz_default_plugins/Path
    Name: Simulated truth trajectory
    Enabled: true
    Color: 30; 100; 230
    Line Style: Lines
    Line Width: 0.02
    Topic:
      Value: /simulation/truth_path
      Durability Policy: Transient Local
    Value: true
  - Class: rviz_default_plugins/Path
    Name: Estimated trajectory
    Enabled: true
    Color: 40; 200; 80
    Line Style: Lines
    Line Width: 0.02
    Topic:
      Value: /simulation/estimated_path
      Durability Policy: Transient Local
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Global inflation
    Enabled: true
    Alpha: 0.25
    Color Scheme: costmap
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
    Update Topic:
      Value: /global_costmap/costmap_updates
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Local inflation
    Enabled: true
    Alpha: 0.25
    Color Scheme: costmap
    Topic:
      Value: /local_costmap/costmap
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
    Update Topic:
      Value: /local_costmap/costmap_updates
    Value: true
  - Class: rviz_default_plugins/Polygon
    Name: Controller footprint
    Enabled: true
    Alpha: 0.4
    Color: 0; 255; 255
    Topic:
      Value: /local_costmap/published_footprint
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Value: true
  - Class: rviz_default_plugins/Polygon
    Name: Global footprint
    Enabled: true
    Alpha: 0.4
    Color: 255; 220; 0
    Topic:
      Value: /global_costmap/published_footprint
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Value: true
  - Class: rviz_default_plugins/Polygon
    Name: Simulated truth footprint
    Enabled: true
    Alpha: 0.4
    Color: 255; 0; 255
    Topic:
      Value: /simulation/truth_footprint
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Value: true
  - Alpha: 0.3
    Class: rviz_default_plugins/GridCells
    Color: 20; 210; 210
    Enabled: true
    Name: Observed free (fresh or under-footprint continuity)
    Topic:
      Value: /local_costmap/local_costmap/observed_free
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 100
      X: 0
      Y: 2.7
    Saved: null
