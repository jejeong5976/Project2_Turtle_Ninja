#usda 1.0
(
    defaultPrim = "TrafficLightPost"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "TrafficLightPost" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    customData = {
        double2 tower_z_m = (0.33, 0.45)
    }
)
{
    bool physics:kinematicEnabled = 1

    def Cube "profile" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </TrafficLightPost/Looks/aluminum>
        color3f[] primvars:displayColor = [(0.7, 0.71, 0.73)]
        double size = 1
        float3 xformOp:scale = (0.02, 0.02, 0.45)
        double3 xformOp:translate = (0, 0, 0.225)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Looks"
    {
        def Material "aluminum"
        {
            token outputs:surface.connect = </TrafficLightPost/Looks/aluminum/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.71, 0.73)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "cap"
        {
            token outputs:surface.connect = </TrafficLightPost/Looks/cap/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.55, 0.55)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
