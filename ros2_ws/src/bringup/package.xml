<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>0.1.0</version>
  <description>F팀 닌자터틀 — 로봇 실행(robot.launch.py) · 인지 쪽 전체 실행(bringup.launch.py) + 공용 설정 config/</description>
  <maintainer email="team@example.com">F팀 닌자터틀</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 이 저장소 패키지 -->
  <exec_depend>description</exec_depend>
  <exec_depend>manipulation</exec_depend>
  <exec_depend>swerve_controller</exec_depend>

  <!-- ros2_control (기성품) -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>hardware</exec_depend>   <!-- hardware:=opencr (D3 A안) -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- bringup.launch.py (인지 쪽 전체). navigation 은 bringup 을 exec_depend 해서 여기 안 넣음 (순환) -->
  <exec_depend>perception</exec_depend>
  <exec_depend>mission</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
