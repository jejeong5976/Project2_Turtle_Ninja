# ArmTask.action — 미션이 팔에게 시키는 일 한 덩어리
#
# 역할
#   - planning 은 집기 · 놓기 · 접기 같은 일만 말하고, 관절 각도 · 순서는 control_master 가 만듦
#   - 무엇과 어떻게를 나눠서, 팔 자세를 바꿔도 planning 은 안 고쳐도 됨
# 액션
#   - /arm_task
# 보내는 쪽 → 받는 쪽
#   - 클라이언트 mission_manager → 서버 control_master
# note
#   - control_master 는 받으면 먼저 바퀴를 세우고 몸통 0.5 s 정지를 확인한 뒤 팔을 움직임, 한 번에 한 무리
#   - 바쁨 · ready 아님 · 모르는 task 번호면 거절
#   - 실패 · 취소 · 시간 초과 뒤에는 STOP 잠금, HOME 이 성공해야 다시 DRIVE
#   - 시작 자세가 맞아야 받음: STORE · PLACE 는 박스 위 기준점(퍽 쥔 채, PICK · RETRIEVE 끝)에서만, LOOK 은 받침에서, PICK · RETRIEVE 는 받침 · LOOK 자세에서
#   - 퍽을 쥔 채 · 작업이 도중에 멈춘 뒤의 HOME 은 거절 (사람 복구)
#   - 주행은 받침에 접혀 끝나는 작업(HOME · STORE · PLACE) 뒤에만. PICK · RETRIEVE 뒤에는 바퀴 잠금 유지
#   - 전체 표: docs/integration/robot_interfaces.md '팔 작업'

uint8 HOME     = 0            # 주행용 접은 자세
uint8 PICK     = 1            # target 위치의 퍽 집기 → 박스 위 기준점에서 쥔 채 멈춤
uint8 PLACE    = 2            # 기준점에서 target 위치에 놓기 → 받침
uint8 STORE    = 3            # 기준점(쥔 퍽) → 적재함 slot 칸에 넣기 → 받침
uint8 RETRIEVE = 4            # 받침 · LOOK 자세 → 적재함 slot 칸의 퍽 꺼내기 → 기준점에서 쥔 채 멈춤
uint8 LOOK     = 5            # 손목 카메라 관찰 자세: 앞 박스 · 장소 위를 내려다봄, 끝나면 그 자세 유지
uint8 LOOK_BARCODE = 6        # 손목 카메라로 출발 구역 벽 바코드를 정면으로 봄, 끝나면 그 자세 유지
uint8 task
geometry_msgs/PoseStamped target   # PICK · PLACE 때만 씀, frame_id = base_link, 그리퍼 중심이 갈 점 (planning_interfaces.md 6 절: 퍽 중심 + 쥘 끝 × 0.015), z 축 = 쥘 끝 · x 축 = 퍽 면
string slot                        # STORE · RETRIEVE 때만 씀, 적재함 칸 S1 ~ S12 (config/rack_cells.yaml)
---
# 결과
bool success
string message
---
# 진행 상황, 중간중간 보냄
string phase                  # control_master 동작 이름: approach · grasp · lift · release · retreat
