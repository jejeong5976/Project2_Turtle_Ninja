# ArmTask.action — 미션이 팔에게 시키는 일 한 덩어리
#
# 역할
#   - planning 은 집기 · 놓기 · 접기 같은 일만 말하고, 관절 각도 · 순서는 control_master 가 만듦
#   - 무엇과 어떻게를 나눠서, 팔 자세를 바꿔도 planning 은 안 고쳐도 됨
# 액션
#   - /arm_task
# 보내는 쪽 → 받는 쪽
#   - 클라이언트 mission_manager → 서버 control_master
# note
#   - control_master 는 받으면 먼저 바퀴를 세우고 몸통 0.5 s 정지를 확인한 뒤 팔을 움직임, 한 번에 한 무리
#   - 바쁨 · ready 아님 · 모르는 task 번호면 거절
#   - 실패 · 취소 · 시간 초과 뒤에는 STOP 잠금, HOME 이 성공해야 다시 DRIVE
#   - STORE 부터 LOOK_RACK 까지는 발제 v5 용으로 planning 이 추가함. control_master 구현 전에는 거절됨
#   - LOOK_RACK 을 거절하면 planning 은 칸 측정 없이 STORE 를 보냄 (target.header.frame_id 빈 값)

uint8 HOME     = 0            # 주행용 접은 자세
uint8 PICK     = 1            # target 위치의 퍽 집기
uint8 PLACE    = 2            # target 위치에 놓기
uint8 STORE    = 3            # 그리퍼에 쥔 퍽 → 적재함 slot 칸에 넣기
uint8 RETRIEVE = 4            # 적재함 slot 칸의 퍽 → 그리퍼로 꺼내기
uint8 LOOK     = 5            # 손목 카메라 관찰 자세: 앞 박스 · 장소 위를 내려다봄, 끝나면 그 자세 유지
uint8 LOOK_BARCODE = 6        # 손목 카메라로 출발 구역 벽 바코드를 정면으로 봄, 끝나면 그 자세 유지
uint8 LOOK_FAR = 7            # LOOK 보다 먼 곳 (L2 중앙 받침대, 격자 중심이 정차점 앞 0.40 m) 을 내려다봄, 끝나면 그 자세 유지
uint8 LOOK_RACK = 8           # 퍽 쥔 채 적재함 slot 칸을 손목 카메라로 내려다봄 (칸마다 관찰 자세 다름, control 표), 끝나면 그 자세 유지 → 다음은 STORE
uint8 task
geometry_msgs/PoseStamped target   # PICK · PLACE: 놓을 · 집을 점, 보통 frame_id = base_link
                                   # STORE: LOOK_RACK 으로 잰 slot 칸 바닥 중심 + yaw (base_link, /perception/rack/cells 그대로)
                                   #        frame_id 빈 값 = 측정 없음 → 녹화 경로 그대로
string slot                        # STORE · RETRIEVE · LOOK_RACK 때 씀, 적재함 칸 이름 = control 과 같은 이름
---
# 결과
bool success
string message
---
# 진행 상황, 중간중간 보냄
string phase                  # control_master 동작 이름: approach · grasp · lift · release · retreat
