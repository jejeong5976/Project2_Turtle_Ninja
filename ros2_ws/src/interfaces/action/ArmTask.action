# ArmTask.action — 미션이 팔에게 시키는 "일 한 덩어리"
# planning 은 "집어" / "놓아" / "접어" 만 말하고, 관절 각도 · 순서는 control_master 가 알아서 만든다.
# ("무엇" 과 "어떻게" 를 나눠서, 팔 자세를 바꿔도 planning 은 안 고쳐도 되게)
# 보내는 쪽(클라이언트): mission/planning_master   받는 쪽(서버): manipulation/control_master
# control_master 는 받으면 먼저 바퀴를 세우고(몸통 0.5 s 정지 확인) 그다음 팔을 움직인다 (한 번에 한 무리, D15)

uint8 HOME  = 0               # 주행용 접은 자세
uint8 PICK  = 1               # target 위치의 퍽 집기
uint8 PLACE = 2               # target 위치에 놓기
uint8 task
geometry_msgs/PoseStamped target   # PICK/PLACE 때만 사용. 보통 frame_id = base_link
---
# 결과
bool success
string message
---
# 진행 상황 (중간중간 보냄)
string phase                  # "planning" | "approach" | "grasp" | "lift" | "release" | "retreat"
