<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navigation</name>
  <version>0.1.0</version>
  <description>라이다 2 개 합치기 · slam_toolbox 지도 만들기 / 위치 찾기 · 위치 감시</description>
  <maintainer email="team@example.com">F팀 닌자터틀</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>coin_d4_driver</exec_depend>   <!-- 앞 · 뒤 LDS-03, apt ros-lyrical-coin-d4-driver -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
