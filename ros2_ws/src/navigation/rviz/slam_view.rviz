# 지도 · 스캔 보기 (Fixed Frame map) — ros2 launch navigation slam.launch.py slam_rviz:=true, 또는 rviz2 -d $(ros2 pkg prefix navigation)/share/navigation/rviz/slam_view.rviz
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Update Topic:
        Value: /map_updates
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: ScanFront
      Enabled: true
      Size (m): 0.02
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Topic:
        Value: /lidar_front/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: ScanRear
      Enabled: true
      Size (m): 0.02
      Style: Points
      Color Transformer: FlatColor
      Color: 60; 120; 255
      Topic:
        Value: /lidar_rear/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: ScanMerged
      Enabled: true
      Size (m): 0.03
      Style: Points
      Color Transformer: FlatColor
      Color: 40; 200; 40
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.3
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/Path
      Name: FollowPath
      Enabled: true
      Color: 25; 255; 0
      Topic:
        Value: /path_follow/path
        Durability Policy: Transient Local
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 80
      X: 0
      Y: 0
    Saved: ~
