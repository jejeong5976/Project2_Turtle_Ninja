    <disable_collisions link1="birdeye_camera_link" link2="wheel_rl_link" reason="Never"/>
    <disable_collisions link1="birdeye_camera_link" link2="wheel_rr_link" reason="Never"/>
    <disable_collisions link1="gripper_left_link" link2="gripper_right_link" reason="Default"/>
    <disable_collisions link1="gripper_left_link" link2="link4" reason="Never"/>
    <disable_collisions link1="gripper_left_link" link2="link5" reason="Never"/>
    <disable_collisions link1="gripper_left_link" link2="wrist_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_park_stand_link" link2="lidar_front_link" reason="Never"/>
    <disable_collisions link1="gripper_park_stand_link" link2="lidar_rear_link" reason="Never"/>
