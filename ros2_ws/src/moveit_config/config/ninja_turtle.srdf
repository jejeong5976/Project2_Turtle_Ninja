    <disable_collisions link1="wheel_fl_link" link2="wheel_rl_link" reason="Never"/>
    <disable_collisions link1="wheel_fl_link" link2="wheel_rr_link" reason="Never"/>
    <disable_collisions link1="wheel_fr_link" link2="wheel_rl_link" reason="Never"/>
    <disable_collisions link1="wheel_fr_link" link2="wheel_rr_link" reason="Never"/>
    <disable_collisions link1="wheel_rl_link" link2="wheel_rr_link" reason="Never"/>
    <!-- 접힌 자세(주행 자세)에서 늘 닿아 있는 쌍: 그리퍼가 거치대에 얹히고 link2 와 손목이 맞닿음 -->
    <disable_collisions link1="gripper_left_link" link2="gripper_park_stand_link" reason="Default"/>
    <disable_collisions link1="gripper_park_stand_link" link2="gripper_right_link" reason="Default"/>
    <disable_collisions link1="link2" link2="wrist_link" reason="Default"/>
</robot>
