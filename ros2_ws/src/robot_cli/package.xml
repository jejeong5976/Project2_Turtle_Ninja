<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_cli</name>
  <version>0.1.0</version>
  <description>로봇 상태 화면 (팔 관절 · 차례 · 위치 · Nav2 · 인지 · 진단) + 명령 CLI (팔 작업 · Nav2 · 수동 주행 · 정지)</description>
  <maintainer email="team@example.com">F팀 닌자터틀</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>ament_index_cpp</depend>
  <depend>action_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>interfaces</depend>
  <depend>rcl_interfaces</depend>
  <depend>urdf</depend>
  <depend>yaml-cpp</depend>
  <depend>libncurses-dev</depend>
  <exec_depend>bringup</exec_depend>
  <exec_depend>ros2bag</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
