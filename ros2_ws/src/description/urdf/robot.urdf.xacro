  <joint name="arm_base_joint" type="fixed"><parent link="base_link" /><child link="link1" /><origin xyz="$(arg arm_mount_x) $(arg arm_mount_y) $(arg arm_mount_z)" rpy="0 0 $(arg arm_mount_yaw)" /></joint>
  <joint name="joint1" type="revolute"><parent link="link1" /><child link="link2" /><origin xyz="0 0 0" rpy="0 0 1.65192969333263" /><axis xyz="4.2922224e-20 -1.22808217e-19 1" /><limit lower="-3.14159265358979" upper="3.14159265358979" effort="4.1" velocity="4.8" /></joint>
  <joint name="joint2" type="revolute"><parent link="link2" /><child link="link3" /><origin xyz="-0.00818725488 -0.0172562701 0.0405" rpy="-0.0702715101621958 -0.146922948567712 0.00517367264559843" /><axis xyz="0.42865208814261 0.90346963830058 -3.60532141119947e-16" /><limit lower="-1.5" upper="1.5" effort="4.1" velocity="4.8" /></joint>
  <joint name="joint3" type="revolute"><parent link="link3" /><child link="link4" /><origin xyz="0.0564421339 0.0152810464 0.122412316" rpy="0.314942732921767 0.578400770037455 0.0944208666904185" /><axis xyz="0.42865208814261 0.90346963830058 -1.13101149037628e-15" /><limit lower="-1.5" upper="1.4" effort="4.1" velocity="4.8" /></joint>
  <joint name="joint4" type="revolute"><parent link="link4" /><child link="link5" /><origin xyz="0.0837025426 -0.0817728306 0.0559203768" rpy="0.100310507818748 0.208016764036196 0.0104796110834654" /><axis xyz="0.42865208814261 0.90346963830058 3.62556313120621e-15" /><limit lower="-1.7" upper="0.673475800587938" effort="4.1" velocity="4.8" /></joint>
  <joint name="joint5" type="revolute"><parent link="link5" /><child link="wrist_link" /><origin xyz="0.0468000374 -0.00117428823 -0.0456961436" rpy="0.0281770785855214 -0.0128000821217835 -0.0332370782500288" /><axis xyz="0.617502360067625 -0.292974622032085 -0.729970346079942" /><limit lower="-1.5708" upper="1.5708" effort="4.1" velocity="4.8" /></joint>
  <joint name="gripper_left_joint" type="prismatic"><parent link="wrist_link" /><child link="gripper_left_link" /><origin xyz="0.0363703506666601 0.0141787026983163 -0.0461597144674409" rpy="0 0 0" /><axis xyz="0.428628063 0.903481036 -2.48981564e-05" /><limit lower="-0.003" upper="0.0175" effort="1" velocity="4.8" /></joint>
  <joint name="gripper_right_joint" type="prismatic"><parent link="wrist_link" /><child link="gripper_right_link" /><origin xyz="0.0120217498033399 -0.0371383839983163 -0.0461606931325592" rpy="0 0 0" /><axis xyz="-0.428628063 -0.903481036 2.48981564e-05" /><limit lower="-0.003" upper="0.0175" effort="1" velocity="4.8" /><mimic joint="gripper_left_joint" multiplier="1.0" offset="0" /></joint>
  <link name="end_effector_link"/>
  <joint name="end_effector_joint" type="fixed"><parent link="wrist_link"/><child link="end_effector_link"/><origin xyz="0.070261725235 -0.0333357494 -0.1006159938" rpy="0 0 0"/></joint>
  <xacro:if value="$(arg with_accessories)">
  <link name="camera_link"/>
  <!-- 표시 몸체: 손눈 보정에 사용한 기존 CAD front→color 고정 변환으로 역산. -->
  <joint name="camera_body_joint" type="fixed"><parent link="wrist_link" /><child link="camera_link" /><origin xyz="0.07285831910124538 -0.03358933820604513 -0.01335717514995661" rpy="-0.01555906262262852 1.249203250793414 -0.4626942145495506" /></joint>
  <link name="wrist_cam_color_optical_frame"/>
  <!-- 실측 손눈 보정 T_5c/T_5d (바닥 깊이) 에 적재함 칸 태그 스캔으로 맞춘 회전을 더함.
       11-04: 옛 적재함 · 옛 칸 표로 경첩 (컬러 광학 x) −5.63°.
       11-06: 카메라를 손목에 다시 붙인 뒤, 새 적재함 (CAD 칸 간격 · 가운데 140 mm 를 자로 확인) 12 칸 태그 110 장으로
       컬러 광학 축 회전 (x −3.14°, y −1.11°, z −0.87°) 을 더 곱함 (칸 남는 오차 평균 1.1 · 최대 2.0 mm, 적재함 이동 (+0.5, +2.9) mm 같이 맞춤).
       광축 ↔ 손가락 (J5 축) 33.5°. 브래킷 배치를 맞추려고 바꾸지 않는다. -->
  <joint name="camera_joint" type="fixed"><parent link="wrist_link"/><child link="wrist_cam_color_optical_frame"/><origin xyz="0.086934 -0.004296 -0.013517" rpy="-2.973050 0.011127 -2.000066"/></joint>
  <link name="wrist_cam_depth_optical_frame"/>
  <joint name="wrist_cam_depth_optical_joint" type="fixed"><parent link="wrist_link"/><child link="wrist_cam_depth_optical_frame"/><origin xyz="0.080572 -0.017984 -0.013716" rpy="-2.966714 0.000048 -1.992139"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="wrist_cam_color_optical_frame"/><child link="camera_optical_frame"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="d435_color_optical_frame"/> <!-- 인지 노드(config/perception.yaml) 와 시뮬 URDF 가 쓰는 이름 — wrist_cam_color_optical_frame 과 같은 자리 -->
  <joint name="d435_color_optical_alias" type="fixed"><parent link="wrist_cam_color_optical_frame"/><child link="d435_color_optical_frame"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="birdeye_camera_link">
    <inertial><mass value="0.03" /><origin xyz="-7.95939647524e-10 4.86405549172e-09 -1.25984772614e-09" rpy="0 0 0" /><inertia ixx="4.49999999906e-06" ixy="3.48294520581e-16" ixz="-1.11386357223e-15" iyy="3.2500000024e-06" iyz="1.03374741921e-15" izz="3.24999999854e-06" /></inertial>
    <visual name="birdeye_camera_link__visual__camera_pcb"><geometry><mesh filename="${mesh}/camera/birdeye_pcb.obj" scale="1 1 1" /></geometry><material name="camera_pcb_material"><color rgba="0.05 0.3 0.12 1" /></material></visual>
    <collision name="birdeye_camera_link__collision__camera_pcb"><geometry><mesh filename="${mesh}/camera/collision/birdeye_pcb.obj" scale="1 1 1" /></geometry></collision>
    <visual name="birdeye_camera_link__visual__camera_lens_seat"><geometry><mesh filename="${mesh}/camera/birdeye_lens_seat.obj" scale="1 1 1" /></geometry><material name="camera_lens_seat_material"><color rgba="0.08 0.08 0.08 1" /></material></visual>
    <collision name="birdeye_camera_link__collision__camera_lens_seat"><geometry><mesh filename="${mesh}/camera/collision/birdeye_lens_seat.obj" scale="1 1 1" /></geometry></collision>
    <visual name="birdeye_camera_link__visual__camera_lens"><geometry><mesh filename="${mesh}/camera/birdeye_lens.obj" scale="1 1 1" /></geometry><material name="camera_lens_material"><color rgba="0.02 0.05 0.08 1" /></material></visual>
    <collision name="birdeye_camera_link__collision__camera_lens"><geometry><mesh filename="${mesh}/camera/collision/birdeye_lens.obj" scale="1 1 1" /></geometry></collision>
    <visual name="birdeye_camera_link__visual__camera_connector"><geometry><mesh filename="${mesh}/camera/birdeye_connector.obj" scale="1 1 1" /></geometry><material name="camera_connector_material"><color rgba="0.5 0.5 0.5 1" /></material></visual>
    <collision name="birdeye_camera_link__collision__camera_connector"><geometry><mesh filename="${mesh}/camera/collision/birdeye_connector.obj" scale="1 1 1" /></geometry></collision>
  </link>
  <link name="birdeye_camera_optical_frame"/>
  <!-- 11-07: 새 버드아이 브래킷 (cam_brkt - Part 3, 카메라 판 30°) → 아래 30° (예전 클램프 40°). 자리는 예전 그대로 (새 브래킷 자리는 아직 안 잼) -->
  <joint name="birdeye_camera_joint" type="fixed"><parent link="profile_camera_bracket_link" /><child link="birdeye_camera_link" /><origin xyz="0.0555354645249 0.0065 0.0195025360476" rpy="0 0.523598775598 0" /></joint>
  <joint name="birdeye_camera_optical_joint" type="fixed"><parent link="birdeye_camera_link" /><child link="birdeye_camera_optical_frame" /><origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" /></joint>
  </xacro:if>

  <!-- ===================== 모터 연결 ===================== -->
  <xacro:nt_buses buses="${hw['buses']}" hardware="$(arg hardware)"/>

  <!-- 젯슨 Orin Nano · 배터리 · 하판: 보기용만 (질량은 base_link 에 포함) -->
  <link name="jetson_link">
    <visual name="jetson_link__visual__orin_nano_devkit_0_6">
      <geometry>
        <mesh filename="${mesh}/electronics/jetson_carrier.obj" />
