    </visual>
  </link>
  <joint name="jetson_joint" type="fixed">
    <parent link="base_link" />
    <child link="jetson_link" />
    <origin xyz="-0.0054 -0.0475 0.031383" rpy="0 0 -1.5707963" />
  </joint>
  <!-- OpenCR 2 장 (앞 = 주행, 뒤 = 팔): 위에서 찍은 사진으로 맞춘 위치 · 보기용만 -->
  <link name="opencr_drive_link">
    <visual name="opencr_drive_visual">
      <geometry><mesh filename="${mesh}/electronics/opencr_drive.obj" /></geometry>
      <material name="opencr_drive_color"><color rgba="0.08 0.43 0.62 1" /></material>
    </visual>
  </link>
  <joint name="opencr_drive_mount" type="fixed">
    <parent link="base_link" /><child link="opencr_drive_link" />
    <origin xyz="0.035 0.139 0.0465" rpy="0 0 0" />
  </joint>
  <link name="opencr_arm_link">
    <visual name="opencr_arm_visual">
      <geometry><mesh filename="${mesh}/electronics/opencr_arm.obj" /></geometry>
      <material name="opencr_arm_color"><color rgba="0.08 0.43 0.62 1" /></material>
    </visual>
  </link>
  <joint name="opencr_arm_mount" type="fixed">
    <parent link="base_link" /><child link="opencr_arm_link" />
    <origin xyz="-0.107 -0.028 0.039" rpy="0 0 0" />
  </joint>
  <!-- 라이다 연결 보드 2 장 (가운데 · 오른쪽 앞): 사진에서 판 구멍으로 원근을 맞춰 읽은 위치, 15 × 31 mm · 보기용만 -->
  <link name="lidar_board_center_link">
    <visual name="lidar_board_center_visual">
      <geometry><box size="0.015 0.031 0.002" /></geometry>
      <material name="lidar_board_center_color"><color rgba="0.1 0.6 0.2 1.0" /></material>
    </visual>
  </link>
  <joint name="lidar_board_center_mount" type="fixed">
    <parent link="base_link" /><child link="lidar_board_center_link" />
    <origin xyz="-0.029 0.013 0.0864575" rpy="0 0 -0.052359877560" />
  </joint>
  <link name="lidar_board_front_right_link">
