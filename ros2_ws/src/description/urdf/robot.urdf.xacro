<?xml version="1.0"?>
<!--
  robot.urdf.xacro — 닌자터틀 로봇 전체 (모양 + 관절 + 모터 연결)
  ====================================================================
  구성
    몸통 · 스워브 : 와플 판 3층 + 하판, 스워브 모듈 4 개 (팀 Swerve CAD, 모듈 위치는 실측)
    팔           : OpenManipulator-X 5 관절 + 그리퍼 (joint1~5 · gripper_left_joint), 적재함 12 칸 (rack_cell_S1 … S12, 팔에서 먼 칸부터)
    센서         : 앞 · 뒤 LDS-03, 손목 D435, 광각 카메라(프로파일 위), IMU (주행 OpenCR 보드 위)
    전자부품     : 젯슨, 배터리, OpenCR 2 장, 라이다 연결 보드 2 장 — 보기용만 (질량은 base_link 에 포함)

  누가 읽나
    robot_state_publisher → TF (base_link → 바퀴 · 팔 · 센서 위치)
    ros2_control_node     → <ros2_control> 블록 (어느 관절을 어느 모터로, ros2_control.xacro)
    Isaac Sim             → 같은 파일을 USD 로 변환해 씀 (모델은 하나만 유지)

  숫자의 출처
    - 모듈 위치 · 총질량 3.81 kg · 라이다 높이 60 mm · IMU · 보드 배치: 실측
    - 판 · 지지대 · 바퀴 치수: 팀 Swerve CAD (Assembly_1.step)
    - 팔 관절 · 형상: OpenManipulator-X CAD + 실물 영점 (q = (tick − zero) · 2π/4096)
    - 손목 카메라 광학 프레임: 손눈 보정 결과 (T_5c · T_5d)
    링크 · 관절 이름은 다른 패키지와의 약속 — 바꾸면 controllers.yaml · control.yaml · hardware_map.yaml 도 같이

  인자
    hardware          mock | opencr   (gazebo 는 시뮬레이션용 자리 — ros2_control.xacro 설명)
    hardware_map      보드 · 모터 배치 yaml 경로
    arm_mount_x/y/z/yaw  팔 받침 위치        with_accessories  프로파일 · 카메라 · 전자부품 보기용 켜기
    lidar_{front,rear}_{x,y,z,yaw}  라이다 장착 (launch 에서 바꿔 볼 때만)
-->
<robot name="ninja_turtle" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="hardware" default="mock"/>
  <xacro:arg name="with_gripper_linkage" default="true" />
  <!-- 팔 받침 위치 (base_link 기준, 실측) -->
  <xacro:arg name="arm_mount_x" default="0.0225499941511"/>
  <xacro:arg name="arm_mount_y" default="0.0"/>
  <xacro:arg name="arm_mount_z" default="0.166512411"/>
  <xacro:arg name="arm_mount_yaw" default="-1.208484306590865"/>
  <xacro:arg name="with_accessories" default="true"/>
  <xacro:arg name="hardware_map" default="$(find bringup)/config/hardware_map.yaml"/>
  <xacro:arg name="opencr_port" default="auto"/>   <!-- hardware:=opencr 때 포트 바꾸기 — 보드 1장일 때만 (auto = hardware_map.yaml 의 port) -->
  <xacro:arg name="opencr_ports" default="auto"/>  <!-- 보드마다: bus_drive=/tmp/opencr_drive,bus_arm=/tmp/opencr_arm (auto = hardware_map.yaml) -->

  <xacro:property name="hw" value="${xacro.load_yaml('$(arg hardware_map)')}"/>
  <!-- hardware:=mock 일 때 true 면 조향 · 바퀴에 속도 · 가속 한계가 있는 가짜 모터 (hardware/MockDynamics) -->
  <xacro:arg name="mock_dynamics" default="false"/>
  <!-- 라이다 장착 = 스캔면(광학 중심) 위치. 바닥에서 60 mm 실측. base_scan_* 는 lidar_*_link 와 같은 점 -->
  <xacro:arg name="lidar_front_x" default="0.1145"/>
  <xacro:arg name="lidar_front_y" default="0.0"/>
  <xacro:arg name="lidar_front_z" default="0.060"/>
  <xacro:arg name="lidar_front_yaw" default="3.14159265"/>
  <xacro:arg name="lidar_rear_x" default="-0.1145"/>
  <xacro:arg name="lidar_rear_y" default="0.0"/>
  <xacro:arg name="lidar_rear_z" default="0.060"/>
  <xacro:arg name="lidar_rear_yaw" default="0"/>
  <xacro:property name="mock_dynamics" value="${'$(arg mock_dynamics)' == 'true'}"/>
  <xacro:property name="opencr_ports" value="${dict([kv.split('=', 1) for kv in '$(arg opencr_ports)'.split(',') if '=' in kv])}"/>
  <xacro:property name="mesh" value="package://description/meshes"/>

  <!-- ===================== 치수 (팀 Swerve CAD, Assembly_1.step 에서 잼) ===================== -->
  <!-- base_link 원점 = 몸체 가운데(라이다 · 팔 CAD 기준), 바퀴축 높이. 단위 m
       (실측: 조향축 4개의 중심은 여기서 5 mm 뒤 — 앞 +60 · 뒤 −70 mm, controllers.yaml module_x 와 같음) -->
  <xacro:property name="wheel_r" value="0.033"/>       <!-- 바퀴 반지름 (CAD 타이어 33.0 mm, 터틀봇3 바퀴와 같음) -->
  <xacro:property name="module_x_front" value="0.060"/>
  <xacro:property name="module_x_rear" value="0.070"/>  <!-- · 뒤 −70 mm (controllers.yaml module_x 와 같은 값) -->
  <xacro:property name="module_y" value="0.112"/> <!-- 좌우 반간격 (controllers.yaml module_y 와 같은 값) -->
  <xacro:property name="wheel_off" value="0.0269"/>    <!-- 바퀴 중심이 조향축에서 바깥쪽으로 떨어진 거리 (바퀴축 방향) -->
  <xacro:property name="plate_low" value="0.039"/>     <!-- 1층 판 아랫면 (바닥에서 72 mm) -->
  <xacro:property name="plate_top" value="0.1306"/>    <!-- 3층(맨 위) 판 윗면 (바닥에서 164 mm) -->
  <xacro:property name="body_front" value="0.141"/>    <!-- 몸통 앞 끝 -->
  <xacro:property name="body_back" value="-0.133"/>    <!-- 몸통 뒤 끝 -->
  <xacro:property name="body_half_w" value="0.133"/>   <!-- 몸통 반폭 -->

  <xacro:include filename="$(find description)/urdf/ros2_control.xacro"/>

  <material name="waffle"><color rgba="0.62 0.55 0.62 1"/></material>  <!-- CAD 그림의 연보라 와플 판 -->
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="motor"><color rgba="0.10 0.10 0.10 1"/></material>
  <material name="metal"><color rgba="0.75 0.75 0.78 1"/></material>
  <material name="arm"><color rgba="0.30 0.30 0.32 1"/></material>
  <material name="wrist_motor"><color rgba="0.13 0.62 0.38 1"/></material>  <!-- 초록 = 손목 모터 -->
  <material name="wrist_plate"><color rgba="0.93 0.55 0.15 1"/></material>   <!-- 주황 = 손목 판 -->
  <material name="frame_blue"><color rgba="0.20 0.42 0.85 1"/></material> <!-- 파란 프레임 FR12-H104 -->
  <material name="tire"><color rgba="0.55 0.22 0.12 1"/></material>
  <material name="camera"><color rgba="0.55 0.55 0.60 1"/></material>

  <!-- ===================== 몸통 (와플파이 3층 + 조향 모터 4개) ===================== -->
  <link name="base_footprint"/>
  <link name="base_link">
    <!-- 질량 2.270004 kg = 총질량 3.81 kg 실측 − 팔 · 조향 모듈 · 바퀴 · 프로파일 · 위 카메라. 무게중심 · 관성 = 부품 합:
         공개 무게: 조향 모터 XM430-W350 82 g × 4 (ROBOTIS), Jetson Orin Nano 개발 키트 176 g (NVIDIA), OpenCR 1.0 60 g × 2,
         배터리 LB-012 106 g, LDS-03 42 g × 2 (ROBOTIS) — 각 링크 자리에 상자 / 나머지 1.4560 kg (판 · 지지대 · 나사 · 배선) = 몸통 상자 -->
    <inertial>
      <origin xyz="-0.000338 -0.000726 0.065100"/>
      <mass value="2.270004"/>
      <inertia ixx="0.017098623" ixy="-0.000516406" ixz="-0.000282214" iyy="0.015236433" iyz="-0.000169549" izz="0.027398245"/>
    </inertial>
    <!-- 배터리 받침 1층: 앞뒤로 긴 배치, 판과 체결물을 함께 배치하고 배터리 방향은 유지 -->
    <visual name="clean_waffle_fl1_01"><origin xyz="-0.064 0.032 0.0434574542149" rpy="1.57079632679 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl1_02"><origin xyz="-0.064 -0.032 0.0434574542149" rpy="1.57079632679 0 4.71238898038"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl1_03"><origin xyz="0.064 0.032 0.0434574542149" rpy="1.57079632679 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl1_04"><origin xyz="0.064 -0.032 0.0434574542149" rpy="1.57079632679 0 4.71238898038"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl2_05"><origin xyz="0.032 0.064 0.0809574542149" rpy="1.57079632679 0 3.14159265359"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl2_06"><origin xyz="0.096 -0.064 0.0809574542149" rpy="1.57079632679 0 0"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl2_07"><origin xyz="-0.096 -0.064 0.0809574542149" rpy="1.57079632679 0 3.14159265359"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl2_08"><origin xyz="-0.032 0.064 0.0809574542149" rpy="1.57079632679 0 0"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl2_09"><origin xyz="-0.032 -0.064 0.0809574542149" rpy="1.57079632679 0 0"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl2_10"><origin xyz="0.096 0.064 0.0809574542149" rpy="1.57079632679 0 0"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl2_11"><origin xyz="0.032 -0.064 0.0809574542149" rpy="1.57079632679 0 3.14159265359"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl2_12"><origin xyz="-0.096 0.064 0.0809574542149" rpy="1.57079632679 0 3.14159265359"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl3_13"><origin xyz="-0.064 0.096 0.125957454215" rpy="1.57079632679 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl3_14"><origin xyz="-0.064 -0.096 0.125957454215" rpy="1.57079632679 0 -1.57079632679"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl3_15"><origin xyz="0.096 -1.52766688188e-16 0.125957454215" rpy="1.57079632679 0 0"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl3_16"><origin xyz="0.064 0.096 0.125957454215" rpy="1.57079632679 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl3_17"><origin xyz="-0.096 -5.3290705182e-17 0.125957454215" rpy="1.57079632679 0 3.14159265359"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl3_18"><origin xyz="0.064 -0.096 0.125957454215" rpy="1.57079632679 0 -1.57079632679"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl3_19"><origin xyz="0.032 -5.3290705182e-17 0.125957454215" rpy="1.57079632679 0 3.14159265359"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="clean_waffle_fl3_20"><origin xyz="-0.032 -1.52766688188e-16 0.125957454215" rpy="1.57079632679 0 0"/><geometry><mesh filename="${mesh}/base/waffle_plate.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_0"><origin xyz="-0.088 0.064 0.045837453" rpy="-2.03590508845e-17 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/support_hex_m3_0xl35_ff_1.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_1"><origin xyz="-0.088 0.064 0.0609574531602" rpy="5.55111512313e-17 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/support_hex_m3_0xl35_ff.obj"/></geometry><material name="waffle"/></visual>
    <xacro:unless value="$(arg with_accessories)">
      <visual name="cad_hardware_2"><origin xyz="0 0.024 0.039757453119" rpy="1.08420217249e-18 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/nut2_m3.obj"/></geometry><material name="waffle"/></visual>
    </xacro:unless>
    <visual name="cad_hardware_3"><origin xyz="0 0.024 0.041957453" rpy="5.55111512313e-17 -2.22044604925e-16 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/phs_m3x8_1.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_4"><origin xyz="0.04 0 0.041957453" rpy="-2.22044604925e-16 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/phs_m3x8_1.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_5"><origin xyz="0.088 -0.064 0.0609574531602" rpy="1.11022302463e-16 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/support_hex_m3_0xl35_ff.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_6"><origin xyz="0.04 0.0640148349819 0.0460223625369" rpy="-1.88709330872e-15 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/phs_m3x8.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_7"><origin xyz="-0.0759925825057 -0.0640128474729 0.0408925440952" rpy="-3.14159265323 -1.05341091405e-09 -1.04719756268"/><geometry><mesh filename="${mesh}/base/hardware/phs_m3x8.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_8"><origin xyz="-0.0419998507515 0.0106130729095 0.0520631278598" rpy="-3.49703413369e-17 4.4408920985e-16 8.14717886994e-16"/><geometry><mesh filename="${mesh}/base/hardware/m_pr07_a01_bracket_2_1.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_9"><origin xyz="0 0.012 0.039757453119" rpy="2.77555756156e-16 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/nut2_m3.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_10"><origin xyz="-0.0879925825057 0.0639871525271 0.0408925440952" rpy="-3.14159265323 -1.05341069201e-09 -1.04719756268"/><geometry><mesh filename="${mesh}/base/hardware/phs_m3x8.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_11"><origin xyz="-0.04 0 0.041957453" rpy="-5.55111512313e-17 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/phs_m3x8_1.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_12"><origin xyz="-0.0420001492485 -0.0106130729095 0.0520631278598" rpy="-4.4408920985e-16 4.4408920985e-16 -3.14159265359"/><geometry><mesh filename="${mesh}/base/hardware/m_pr07_a01_bracket_2_1.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_13"><origin xyz="-0.0390049682413 0.0100061766684 0.049845779434" rpy="5.3564001362e-17 0 -2.09235762928e-16"/><geometry><mesh filename="${mesh}/base/hardware/pr07_one_rivet_2.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_14"><origin xyz="-0.052 0 0.039757453119" rpy="-8.67361737988e-18 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/nut2_m3.obj"/></geometry><material name="waffle"/></visual>
    <xacro:unless value="$(arg with_accessories)">
      <visual name="cad_hardware_15"><origin xyz="0 -0.024 0.039757453" rpy="1.84889274661e-32 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/nut2_m3_1.obj"/></geometry><material name="waffle"/></visual>
    </xacro:unless>
    <visual name="cad_hardware_16"><origin xyz="-0.0390049682413 0.0160061766684 0.049845779434" rpy="3.48811261023e-18 0 -9.29126031869e-17"/><geometry><mesh filename="${mesh}/base/hardware/pr07_one_rivet_2.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_17"><origin xyz="0.052 -0.064 0.039757453119" rpy="4.16333634234e-17 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/nut2_m3.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_18"><origin xyz="0 -0.012 0.041957453" rpy="6.08593862426e-32 2.22044604925e-16 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/phs_m3x8_1.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_19"><origin xyz="-0.076 0 0.039757453" rpy="0 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/nut2_m3_1.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_20"><origin xyz="0.0880074174943 -0.0640128474729 0.0408925440952" rpy="-3.14159265323 -1.0534111361e-09 -1.04719756268"/><geometry><mesh filename="${mesh}/base/hardware/phs_m3x8.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_21"><origin xyz="-0.0390049682413 -0.0159938233316 0.049845779434" rpy="-2.90487142583e-17 0 -1.96514664479e-16"/><geometry><mesh filename="${mesh}/base/hardware/pr07_one_rivet_2.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_22"><origin xyz="0.088 0 0.039757453119" rpy="2.49800180541e-16 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/nut2_m3.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_23"><origin xyz="-0.0420001492485 -0.0106130729095 0.0520631278598" rpy="4.31720968079e-17 -2.22044604925e-16 8.40740884388e-16"/><geometry><mesh filename="${mesh}/base/hardware/m_pr07_a01_bracket_2_2.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_24"><origin xyz="-0.076 -0.064 0.045837453" rpy="-5.49077208224e-15 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/support_hex_m3_0xl35_ff_1.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_25"><origin xyz="0 0.0240148349819 0.0460223625369" rpy="1.88748902955e-15 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/phs_m3x8.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_26"><origin xyz="0.04 1.48349819376e-05 0.0460223625369" rpy="-3.77380005506e-15 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/phs_m3x8.obj"/></geometry><material name="waffle"/></visual>
    <visual name="cad_hardware_27"><origin xyz="0.04 0 0.039757453" rpy="-1.11022302463e-16 0 1.57079632679"/><geometry><mesh filename="${mesh}/base/hardware/nut2_m3_1.obj"/></geometry><material name="waffle"/></visual>
