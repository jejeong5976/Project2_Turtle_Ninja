    <!-- 하판과 배터리판 중앙 연결: 공통 체결 홀의 좌우 지지대 2개와 하단 나사 -->
    <xacro:macro name="lower_plate_support_visual" params="name y">
      <visual name="lower_plate_support_${name}">
        <origin xyz="0 ${y} 0.0207893056" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh}/base/hardware/support_hex_m3_0xl45_ff.obj"/></geometry>
        <material name="metal"/>
      </visual>
      <visual name="lower_plate_support_${name}_bolt">
        <origin xyz="0 ${y + 0.0000148349819} -0.01106492731" rpy="${pi} 0 ${pi/2}"/>
        <geometry><mesh filename="${mesh}/base/hardware/phs_m3x8.obj"/></geometry>
        <material name="metal"/>
      </visual>
      <visual name="lower_plate_support_${name}_bolt_shaft">
        <origin xyz="0 ${y} -0.00700001777" rpy="${pi} 0 ${pi/2}"/>
        <geometry><mesh filename="${mesh}/base/hardware/phs_m3x8_1.obj"/></geometry>
        <material name="metal"/>
      </visual>
    </xacro:macro>
    <xacro:if value="$(arg with_accessories)">
      <xacro:lower_plate_support_visual name="left" y="0.024"/>
      <xacro:lower_plate_support_visual name="right" y="-0.024"/>
    </xacro:if>

    <!-- 조향 모터: 몸통 고정, 혼 축은 모듈 회전축과 일치. 긴 몸체는 안쪽으로, 혼은 아래로 향함 -->
    <xacro:macro name="steering_motor_visual" params="name x y yaw">
      <visual name="steering_motor_${name}">
        <origin xyz="${x} ${y} 0.0404574547" rpy="0 0 ${yaw}"/>
        <geometry><mesh filename="${mesh}/base/steer_motor.obj"/></geometry>
        <material name="motor"/>
      </visual>
    </xacro:macro>
    <xacro:steering_motor_visual name="fl" x="${-module_x_rear}" y="${module_y}" yaw="${pi/2}"/>
    <xacro:steering_motor_visual name="fr" x="${module_x_front}" y="${module_y}" yaw="${pi/2}"/>
    <xacro:steering_motor_visual name="rl" x="${-module_x_rear}" y="${-module_y}" yaw="${-pi/2}"/>
    <xacro:steering_motor_visual name="rr" x="${module_x_front}" y="${-module_y}" yaw="${-pi/2}"/>
    <collision>
      <origin xyz="${(body_front + body_back) / 2} 0 ${(plate_top + plate_low) / 2}"/>
      <geometry><box size="${body_front - body_back} ${2 * body_half_w} ${plate_top - plate_low}"/></geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_r}"/>   <!-- 바닥 → 바퀴축 높이 -->
  </joint>

  <xacro:if value="$(arg with_accessories)">
  <link name="profile_fixing_plate_link">
    <visual name="profile_fixing_plate_link__visual__CAD_profile_holder"><origin xyz="0 0 0" rpy="0 0 0" /><geometry><mesh filename="${mesh}/structure/profile_holder.obj" scale="1 1 1" /></geometry><material name="CAD_profile_holder_mat"><color rgba="0.95 0.8 0.75 1" /></material></visual>
    <collision name="profile_fixing_plate_link__collision__CAD_concave_profile_holder"><geometry><mesh filename="${mesh}/structure/collision/profile_holder.obj" scale="1 1 1" /></geometry></collision>
  </link>
  <link name="profile_link">
    <visual name="profile_column_link__visual__profile_450mm_0_12"><geometry><mesh filename="${mesh}/structure/profile_450mm.obj" /></geometry><material name="profile_450mm_0_color"><color rgba="0.65 0.68 0.72 1.0" /></material></visual>
    <collision name="profile_column_link__collision__profile_450mm_0_aabb"><origin xyz="-0.110213045 -0.09580939 0.316499985" rpy="0 0 0" /><geometry><box size="0.01999999 0.02 0.44999997" /></geometry></collision>
    <inertial><origin xyz="-0.110258358486 -0.0956971033869 0.316499985" rpy="0 0 0" /><mass value="0.201981990747" /><inertia ixx="0.00341684145836" ixy="8.46704035452e-08" ixz="3.08743509274e-17" iyy="0.00341666638254" iyz="1.71524171819e-17" izz="1.66165620868e-05" /></inertial>
  </link>
  <link name="profile_camera_bracket_link">
    <visual name="profile_camera_bracket_link__visual__clamp"><geometry><mesh filename="${mesh}/camera/bracket_clamp.obj" scale="1 1 1" /></geometry><material name="clamp_material"><color rgba="0.75 0.77 0.8 1" /></material></visual>
    <collision name="profile_camera_bracket_link__collision__clamp"><geometry><mesh filename="${mesh}/camera/collision/bracket_clamp.obj" scale="1 1 1" /></geometry></collision>
    <visual name="profile_camera_bracket_link__visual__lever"><geometry><mesh filename="${mesh}/camera/bracket_lever.obj" scale="1 1 1" /></geometry><material name="lever_material"><color rgba="0.75 0.77 0.8 1" /></material></visual>
    <collision name="profile_camera_bracket_link__collision__lever"><geometry><mesh filename="${mesh}/camera/collision/bracket_lever.obj" scale="1 1 1" /></geometry></collision>
    <visual name="profile_camera_bracket_link__visual__cradle"><geometry><mesh filename="${mesh}/camera/bracket_cradle.obj" scale="1 1 1" /></geometry><material name="cradle_material"><color rgba="0.75 0.77 0.8 1" /></material></visual>
    <collision name="profile_camera_bracket_link__collision__cradle"><geometry><mesh filename="${mesh}/camera/collision/bracket_cradle.obj" scale="1 1 1" /></geometry></collision>
  </link>
  <link name="gripper_park_stand_link">
    <visual name="gripper_park_stand__visual__mani_home"><origin xyz="0 0 0.01650" rpy="0 0 0" /><geometry><mesh filename="${mesh}/arm/park_stand.obj" scale="0.001060 0.001000 0.001100" /></geometry><material name="mani_home_mat"><color rgba="0.45 0.55 0.7 0.9" /></material></visual>
    <collision name="gripper_park_stand_link__collision__floor"><origin xyz="0.00000 0.00000 0.00300" rpy="0 0 0" /><geometry><box size="0.05300 0.05000 0.00600" /></geometry></collision>
    <collision name="gripper_park_stand_link__collision__wall0"><origin xyz="0.025 0 0.01725" rpy="0 0 0" /><geometry><box size="0.003 0.05 0.0225" /></geometry></collision>
    <collision name="gripper_park_stand_link__collision__wall1"><origin xyz="-0.025 0 0.01725" rpy="0 0 0" /><geometry><box size="0.003 0.05 0.0225" /></geometry></collision>
    <collision name="gripper_park_stand_link__collision__wall2"><origin xyz="0 0.0235 0.01725" rpy="0 0 0" /><geometry><box size="0.047 0.003 0.0225" /></geometry></collision>
    <collision name="gripper_park_stand_link__collision__wall3"><origin xyz="0 -0.0235 0.01725" rpy="0 0 0" /><geometry><box size="0.047 0.003 0.0225" /></geometry></collision>
  </link>
  <joint name="profile_fixing_plate_link_mount" type="fixed"><parent link="base_link" /><child link="profile_fixing_plate_link" /><origin xyz="-0.098 -0.101 0.1305" rpy="0 0 0" /></joint>
  <joint name="profile_joint" type="fixed"><parent link="profile_fixing_plate_link" /><child link="profile_link" /><origin xyz="0.110213045 0.09580939 -0.0885" rpy="0 0 0" /></joint>
  <joint name="profile_camera_bracket_link_mount" type="fixed"><parent link="profile_link" /><child link="profile_camera_bracket_link" /><origin xyz="-0.110213045 -0.09580939 0.53649997" rpy="0 0 0.274506446118" /></joint>
  <joint name="gripper_park_stand_mount" type="fixed"><parent link="base_link" /><child link="gripper_park_stand_link" /><origin xyz="0.1008 0.00115 0.1305" rpy="0 0 0" /></joint>
    <!-- 적재함 = 11-05 새 적재함 CAD (Onshape shak3) 메시 그대로: 8 칸 판 · 4 칸 판 (판 · 나사 구멍 · 옆 홈 포함, 홈은 와플 판 바깥쪽)
         rack_link = CAD 원점 (S2 칸 중심, 칸 바닥 위 5 mm). 판 밑면이 상판 (z 0.1305, 받침대와 같은 면) 위
         놓은 자리 = 옛 적재함 자리: 8 칸은 옛 8 칸, 4 칸은 옛 4 칸 자리 (CAD 칸 중심을 옛 config/rack_cells.yaml 12 칸에 평행 이동으로 맞춤)
         옛 칸 표 (11-01 실물 성공 값, backups/rack_cells_1106) 는 칸 간격이 약 65 mm 로 CAD 60 mm 와 달라 칸마다 최대 약 10 mm (S7) 차이 (아래 줄 끝 수치)
         11-06 부터 config/rack_cells.yaml 칸 중심 = 이 칸 링크 (CAD) + 가운데 통로 보정 (왼쪽 8 칸 y +1 · 오른쪽 4 칸 y −1 mm, 자로 140 ↔ URDF 138) -->
    <link name="rack_link">
      <visual><geometry><mesh filename="${mesh}/rack/rack_8cell.obj"/></geometry><material name="rack_visual"><color rgba="0.55 0.74 0.90 1"/></material></visual>
      <visual><geometry><mesh filename="${mesh}/rack/rack_4cell.obj"/></geometry><material name="rack_visual"/></visual>
      <!-- 충돌: 판 (상판 면과 0.5 mm · 칸 벽과 0.1 mm 띄움 — 면이 닿으면 MoveIt 거리 계산이 겹침으로 봄) + 칸 벽 (rack_cell_<칸>_link) -->
      <collision name="rack_plate_8cell"><origin xyz="0.090 0.0225 -0.0063"/><geometry><box size="0.216 0.081 0.0024"/></geometry></collision>
      <collision name="rack_plate_4cell"><origin xyz="0.138 -0.1605 -0.0063"/><geometry><box size="0.120 0.081 0.0024"/></geometry></collision>
    </link>
    <joint name="rack_fixed" type="fixed"><parent link="base_link"/><child link="rack_link"/><origin xyz="-0.102 0.0671 0.1385" rpy="0 0 0"/></joint>
    <!-- 칸 벽 충돌 (메시와 같은 모양): 안쪽 32 mm 정사각 (바닥 위 12.5 mm 까지) → 14° 벌어져 테두리 (바닥 위 27 mm) 에서 39.3 mm, 벽 2 mm -->
    <xacro:property name="rack_flare" value="0.24663"/>
    <xacro:macro name="rack_wall" params="name part xyz rpy size">
      <collision name="rack_cell_${name}_collision_${part}"><origin xyz="${xyz}" rpy="${rpy}"/><geometry><box size="${size}"/></geometry></collision>
    </xacro:macro>
    <!-- 칸 링크 = CAD 칸 바닥 가운데 (x y = rack_link 기준 CAD 칸 중심 [m]) -->
    <xacro:macro name="rack_cell" params="name x y">
      <link name="rack_cell_${name}_link">
        <xacro:rack_wall name="${name}" part="wall_px" xyz="0.017 0 0.00625" rpy="0 0 0" size="0.002 0.036 0.0125"/>
        <xacro:rack_wall name="${name}" part="wall_nx" xyz="-0.017 0 0.00625" rpy="0 0 0" size="0.002 0.036 0.0125"/>
        <xacro:rack_wall name="${name}" part="wall_py" xyz="0 0.017 0.00625" rpy="0 0 0" size="0.032 0.002 0.0125"/>
        <xacro:rack_wall name="${name}" part="wall_ny" xyz="0 -0.017 0.00625" rpy="0 0 0" size="0.032 0.002 0.0125"/>
        <xacro:rack_wall name="${name}" part="flare_px" xyz="0.018825 0 0.01975" rpy="0 ${rack_flare} 0" size="0.00194 0.0397 0.01495"/>
        <xacro:rack_wall name="${name}" part="flare_nx" xyz="-0.018825 0 0.01975" rpy="0 ${-rack_flare} 0" size="0.00194 0.0397 0.01495"/>
        <xacro:rack_wall name="${name}" part="flare_py" xyz="0 0.018825 0.01975" rpy="${-rack_flare} 0 0" size="0.0397 0.00194 0.01495"/>
        <xacro:rack_wall name="${name}" part="flare_ny" xyz="0 -0.018825 0.01975" rpy="${rack_flare} 0 0" size="0.0397 0.00194 0.01495"/>
      </link>
      <joint name="rack_cell_${name}_fixed" type="fixed"><parent link="rack_link"/><child link="rack_cell_${name}_link"/><origin xyz="${x} ${y} -0.005" rpy="0 0 0"/></joint>
    </xacro:macro>
    <!-- 칸 이름 S1–S12 = 팔 J1 축(base_link 0.0225, 0)에서 먼 칸부터. planning 이 S1 부터 채움. 줄 끝 = 옛 이름 · base_link 위치 · 옛 표와 차이 -->
    <xacro:rack_cell name="S1" x="0.000" y="0.045"/>     <!-- 옛 L8, base_link (-0.102, 0.112), 표와 (+8.1, +5.2) mm -->
    <xacro:rack_cell name="S2" x="0.000" y="0.000"/>     <!-- 옛 L7, (-0.102, 0.067), (+7.3, +2.7) -->
    <xacro:rack_cell name="S3" x="0.060" y="0.045"/>     <!-- 옛 L6, (-0.042, 0.112), (+1.4, +1.1) -->
    <xacro:rack_cell name="S4" x="0.180" y="-0.183"/>    <!-- 옛 B, (0.078, -0.116), (-1.5, -1.9) -->
    <xacro:rack_cell name="S5" x="0.180" y="0.045"/>     <!-- 옛 L2, (0.078, 0.112), (-6.3, +4.8) -->
    <xacro:rack_cell name="S6" x="0.120" y="0.045"/>     <!-- 옛 L4, (0.018, 0.112), (-3.9, +2.4) -->
    <xacro:rack_cell name="S7" x="0.120" y="-0.183"/>    <!-- 옛 D, (0.018, -0.116), (+6.4, -7.5) -->
    <xacro:rack_cell name="S8" x="0.060" y="0.000"/>     <!-- 옛 L5, (-0.042, 0.067), (+1.6, -3.4) -->
    <xacro:rack_cell name="S9" x="0.180" y="-0.138"/>    <!-- 옛 A, (0.078, -0.071), (-3.2, +1.2) -->
    <xacro:rack_cell name="S10" x="0.180" y="0.000"/>    <!-- 옛 L1, (0.078, 0.067), (-6.1, +0.3) -->
    <xacro:rack_cell name="S11" x="0.120" y="0.000"/>    <!-- 옛 L3, (0.018, 0.067), (-6.0, -2.1) -->
    <xacro:rack_cell name="S12" x="0.120" y="-0.138"/>   <!-- 옛 C, (0.018, -0.071), (+2.2, -2.8) -->
  </xacro:if>

  <!-- 스워브 모듈 4 개: 위치 · 바퀴 offset 은 controllers.yaml 과 같은 값 -->
  <!-- 모듈 1개 = [몸통에 고정] 조향 모터 → (혼) → [돎] FR12-S102K 브래킷 + 주행 모터 XM430-W210 → (혼) → 바퀴
       ⚠ 바퀴가 조향축 바로 아래가 아니라 바퀴축 방향으로 26.9 mm 바깥에 있음 (주행 모터 옆에 바퀴를 단 구조)
         → 조향하면 바퀴가 조향축 둘레로 작은 원을 그림. 계산은 swerve_controller 의 module_offset 이 맡음 -->
  <!-- 구동 모터 혼과 바퀴 허브의 체결면이 서로 향하도록 visual 방향을 맞춘다. 관절축은 그대로다. -->
  <xacro:macro name="swerve_module" params="name x y off visual_yaw:=0">
    <link name="steer_${name}_link">
      <!-- 구동 모터 XM430-W210 82 g (ROBOTIS) + 브래킷 · 혼 약 18 g -->
      <xacro:box_physics mass="0.10" sx="0.029" sy="0.043" sz="0.054" xyz="0 0 0.016"/>
      <visual>
        <xacro:if value="${visual_yaw != 0}"><origin rpy="0 0 ${visual_yaw}"/></xacro:if>
        <geometry><mesh filename="${mesh}/swerve/module_${name}.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="motor"/>
      </visual>
    </link>
    <joint name="steer_${name}_joint" type="revolute">
      <parent link="base_link"/>
      <child link="steer_${name}_link"/>
      <origin xyz="${x} ${y} 0"/>     <!-- 조향축 (높이는 바퀴축에 맞춤 — 축 위 어디든 같은 뜻) -->
      <axis xyz="0 0 1"/>
      <!-- 한계: 하드웨어 지도에 zero_tick 이 있으면 위치 모드 눈금 0~4095 전체를 관절 각으로 (hardware 와 같은 식).
           ros2_control 이 이 한계로 명령을 자르므로 ±π 로 두면 영점이 2048 에서 먼 모듈(예: 14 번 rr +224°)을 180° 에서 잘라 버림.
           컨트롤러 범위(robot.launch.py, 양 끝 20 눈금 여유)가 이보다 좁아 정상 동작에서는 여기서 잘리지 않음. 영점이 없으면 ±π -->
      <xacro:property name="sm" value="${hw['motors'].get('steer_' + name + '_joint', dict())}"/>
      <xacro:if value="${sm.get('extended')}">   <!-- 여러 바퀴 모드 (모의 전용): 선 한계 그대로 -->
        <limit lower="${float(sm['cable_min_deg']) * pi / 180}" upper="${float(sm['cable_max_deg']) * pi / 180}" effort="3.0" velocity="5.0"/>
      </xacro:if>
      <xacro:if value="${sm.get('zero_tick') is not None and not sm.get('extended')}">
        <xacro:property name="ka" value="${float(sm.get('scale', 1.0)) * (0 - int(sm['zero_tick'])) * 2 * pi / 4096}"/>
        <xacro:property name="kb" value="${float(sm.get('scale', 1.0)) * (4095 - int(sm['zero_tick'])) * 2 * pi / 4096}"/>
        <!-- 선(케이블) 한계 cable_min_deg / cable_max_deg 가 있으면 그 안으로 (robot.launch.py 와 같음) -->
        <limit lower="${max(min(ka, kb), float(sm.get('cable_min_deg', -1e9)) * pi / 180)}"
               upper="${min(max(ka, kb), float(sm.get('cable_max_deg', 1e9)) * pi / 180)}" effort="3.0" velocity="5.0"/>
      </xacro:if>
      <xacro:if value="${sm.get('zero_tick') is None}">
        <limit lower="${-pi}" upper="${pi}" effort="3.0" velocity="5.0"/>
      </xacro:if>
    </joint>

    <link name="wheel_${name}_link">
      <!-- TurtleBot3 바퀴 (turtlebot3_description waffle_pi wheel_left_link 질량 · 관성). 그쪽 회전축 z = 여기 y 라 iyy · izz 를 바꿔 넣음 -->
      <inertial><mass value="0.0284989"/>
        <inertia ixx="1.1175580e-05" ixy="0" ixz="0" iyy="2.0712558e-05" iyz="0" izz="1.1192413e-05"/>
      </inertial>
      <visual>
        <xacro:if value="${visual_yaw != 0}"><origin rpy="0 0 ${visual_yaw}"/></xacro:if>
        <geometry><mesh filename="${mesh}/swerve/wheel_${name}.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="tire"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="0.020"/></geometry>
      </collision>
    </link>
    <joint name="drive_${name}_joint" type="continuous">
      <parent link="steer_${name}_link"/>
      <child link="wheel_${name}_link"/>
      <origin xyz="0 ${off} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:swerve_module name="fl" x="${-module_x_rear}" y="${module_y}" off="${wheel_off}"/>
  <xacro:swerve_module name="fr" x="${module_x_front}" y="${module_y}" off="${wheel_off}" visual_yaw="${pi}"/>
  <xacro:swerve_module name="rl" x="${-module_x_rear}" y="${-module_y}" off="${-wheel_off}" visual_yaw="${pi}"/>
  <xacro:swerve_module name="rr" x="${module_x_front}" y="${-module_y}" off="${-wheel_off}"/>

  <!-- ===================== IMU (D12) ===================== -->
  <!-- 주행 OpenCR 보드의 MPU-9250 = 보드 중심 (위에서 찍은 사진으로 맞춤). 보드 실크 축이 몸통 기준 +90° -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.035 0.069 0.0948" rpy="0 0 1.5707963"/>
  </joint>

  <link name="base_scan"/>
  <joint name="scan_joint" type="fixed"><parent link="lidar_front_link"/><child link="base_scan"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="lidar_front_link">
    <visual name="lidar_front_link__visual__body"><origin xyz="0 0 -0.031" rpy="0 0 0" /><geometry><mesh filename="${mesh}/lidar/lds03_body.obj" /></geometry><material name="lidar_drawing_body"><color rgba=".22 .23 .25 1" /></material></visual>
    <visual name="lidar_front_link__visual__upper_optical_cylinder"><origin xyz="0 0 -0.031" rpy="0 0 0" /><geometry><mesh filename="${mesh}/lidar/lds03_optics.obj" /></geometry><material name="lidar_drawing_upper_optical_cylinder"><color rgba=".08 .09 .11 1" /></material></visual>
    <visual name="lidar_front_link__visual__ear_pair_left"><origin xyz="0 0 -0.031" rpy="0 0 0" /><geometry><mesh filename="${mesh}/lidar/lds03_mount_left.obj" /></geometry><material name="lidar_drawing_ear_pair_left"><color rgba=".23 .24 .26 1" /></material></visual>
    <visual name="lidar_front_link__visual__ear_pair_right"><origin xyz="0 0 -0.031" rpy="0 0 0" /><geometry><mesh filename="${mesh}/lidar/lds03_mount_right.obj" /></geometry><material name="lidar_drawing_ear_pair_right"><color rgba=".23 .24 .26 1" /></material></visual>
