<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mission</name>
  <version>0.1.0</version>
  <description>F팀 닌자터틀 — 판단: planning_master — 미션 상태머신</description>
  <maintainer email="team@example.com">F팀 닌자터틀</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>interfaces</exec_depend>

  <!-- ROS 없는 시험 (action_session · mission_store): colcon test 에서 이 패키지만 골라 실행. XML 주석 안에는 하이픈 두 개를 쓰면 안 됨 -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
